# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
env/

# --- Editors ---
.vscode/
.idea/
*.swp

# --- Jupyter ---
*.ipynb_checkpoints

# --- OS junk ---
.DS_Store
Thumbs.db

# --- Data (raw data usually shouldn't be committed) ---
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md

# --- Large/generated outputs (uncomment if these get big) ---
# data/processed/*
# !data/processed/.gitkeep
# figures/*.png
# figures/*.pdf

# --- Personal/private notes: keep local, don't publish ---
docs/journal.txt
docs/*.txt

# --- FilBAO ---
# Measurements (pair counts, monopoles, spectra) are large and regenerated by
# scripts/multidark_analysis.py; only the small theory caches are tracked.
data/processed/*
!data/processed/README.md
!data/processed/cache/
# Diagnostic plots written by multidark_analysis.py on every run
figures/diagnostics/
# Plots from before the reorganisation (October 2026)
figures/old/
